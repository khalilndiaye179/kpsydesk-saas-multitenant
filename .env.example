# ============================================================
# Inventaire Parc Informatique — Variables d'environnement (EXEMPLE)
# Copiez ce fichier en .env et remplissez les valeurs réelles.
# NE JAMAIS committer le fichier .env avec de vraies valeurs !
# ============================================================

# ---- PORTS (plage 3010-3015 exclusivement) ----
# 3010 : Backend NestJS API
# 3011 : Frontend Vite dev server
# 3012 : PostgreSQL (exposé en dev)
# 3013 : Réservé (ex: worker de facturation)
# 3014 : Réservé (ex: service de notifications)
# 3015 : Réservé (ex: adminer/pgAdmin dev)

BACKEND_PORT=3010
FRONTEND_PORT=3011
DB_PORT=3012

# ---- Base de données PostgreSQL ----
DB_USER=itam_user
DB_PASSWORD=CHANGEME_strong_password_here
DB_NAME=itam_db

# ---- Sécurité backend ----
# Générez une clé aléatoire forte : openssl rand -hex 64
JWT_SECRET=CHANGEME_generate_a_strong_random_secret_here

# ---- CORS (obligatoire en production) ----
# Liste des origines autorisées séparées par des virgules, avec protocole https://
CORS_ORIGINS=https://app.kpsyinformatique.com

# ---- Multi-tenant (dev uniquement) ----
DEFAULT_LEGACY_SUBDOMAIN=legacy

# ---- Email (requis pour l'inscription SaaS en production) ----
SMTP_HOST=mail.kpsyinformatique.com
SMTP_PORT=587
SMTP_USER=khalil.ndiaye@kpsyinformatique.com
SMTP_PASS=
SMTP_FROM_EMAIL=khalil.ndiaye@kpsyinformatique.com
SMTP_FROM_NAME="KPSyDesk ITAM"

# ---- Support WhatsApp ----
# Numéro WhatsApp de support (format international sans +, ex: 221762613939)
VITE_WHATSAPP_SUPPORT_NUMBER=221762613939
