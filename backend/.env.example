# ============================================================
# KPSyDesk ITAM — Backend Environment Variables Example
# ============================================================

# Mode d'exécution ('development' | 'production')
NODE_ENV=development

# Port d'écoute du backend NestJS API (défaut: 3000 dans Docker, mappé sur 3010)
PORT=3000

# URL de connexion à la base de données PostgreSQL
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL=postgresql://itam_user:itam_password_dev_2026@postgres:5432/itam_db?schema=public

# Clé secrète de signature des tokens JWT
# ATTENTION: En production (NODE_ENV=production), l'application refusera de démarrer
# si cette valeur est vide ou correspond aux valeurs par défaut de développement.
# Recommandation : Générer une clé d'au moins 32 caractères aléatoires et complexes
# (ex: openssl rand -base64 32)
JWT_SECRET=itam_secret_jwt_key_2026_change_me_in_production

# Origines autorisées pour les requêtes CORS (séparées par des virgules)
# En production, spécifier l'URL exacte du frontend sans slash final.
CORS_ORIGINS=https://app.kpsyinformatique.com

# Sous-domaine par défaut en mode développement (fallback legacy)
DEFAULT_LEGACY_SUBDOMAIN=legacy

# ── Configuration du serveur SMTP (Envoi de mails/notifs) ───────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@kpsyinformatique.com
SMTP_PASS=your_smtp_secure_password
SMTP_FROM_EMAIL=noreply@kpsyinformatique.com
SMTP_FROM_NAME=KPSyDesk Support

# ── Surveillance et Alertes (Health Check) ──────────────────────────────
# Adresse e-mail recevant les alertes d'incident
ALERT_EMAIL=admin-tech@kpsyinformatique.com
# Nombre d'échecs consécutifs (intervalle 1 minute) requis pour déclencher l'alerte
ALERT_THRESHOLD=3
