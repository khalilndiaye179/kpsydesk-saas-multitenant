# =============================================================
# automation/.env.example — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs réelles
# NE JAMAIS committer .env sur Git
# =============================================================

# ── Sécurité Node-RED ─────────────────────────────────────────

# Clé de chiffrement des credentials Node-RED (min. 32 chars, aléatoire)
# Générer : openssl rand -hex 32
NODE_RED_CREDENTIAL_SECRET=CHANGE_MOI_openssl_rand_hex_32

# Identifiant admin Node-RED
NODE_RED_ADMIN_USER=admin

# Hash bcrypt du mot de passe admin Node-RED
# Générer sur le VPS :
#   docker run --rm node:18-alpine sh -c \
#     "npm install -g bcryptjs 2>/dev/null && node -e \"console.log(require('bcryptjs').hashSync('TONMOTDEPASSE', 12))\""
NODE_RED_ADMIN_PASSWORD_HASH=$2b$12$REMPLACER_PAR_LE_VRAI_HASH_BCRYPT


# ── API Claude (Anthropic) ────────────────────────────────────
# Créer sur : https://console.anthropic.com → API Keys
# La clé est UNIQUEMENT stockée dans les credentials Node-RED (chiffrés)
# Cette variable est une AIDE MÉMOIRE — elle n'est pas lue par le code directement
# Saisir la clé dans l'interface Node-RED → Credentials → "claude_api_key"
ANTHROPIC_API_KEY_REMINDER=sk-ant-xxxxx  # NE PAS UTILISER ICI — saisir dans Node-RED UI


# ── Google Search Console OAuth ───────────────────────────────
# Créer sur : https://console.cloud.google.com → APIs → Credentials → OAuth 2.0
# Scope requis : https://www.googleapis.com/auth/webmasters.readonly
# À saisir dans les credentials Node-RED après génération du refresh token
GOOGLE_CLIENT_ID=XXXXX.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-XXXXX
# Refresh token généré via l'outil d'autorisation OAuth Google
# (voir README.md section "Configuration Google Search Console")
GOOGLE_REFRESH_TOKEN=1//XXXXX


# ── Email SMTP (alertes positionnement) ───────────────────────
# Peut réutiliser le même SMTP que KPSyDesk si tu as les vars
SMTP_HOST=mail.kpsyinformatique.com
SMTP_PORT=587
SMTP_USER=noreply@kpsyinformatique.com
SMTP_PASS=CHANGE_MOI
SMTP_FROM=KPSy Automation <noreply@kpsyinformatique.com>
ALERT_EMAIL_TO=admin@kpsyinformatique.com


# ── Configuration métier ─────────────────────────────────────
# Domaine surveillé par le flow Search Console
GSC_SITE_URL=sc-domain:kpsyinformatique.com

# Seuil d'alerte position (en nombre de rangs perdus)
RANKING_ALERT_THRESHOLD=3
