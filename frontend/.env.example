# KPSyDesk ITAM — Configuration de l'environnement Frontend
# Renommez ce fichier en .env ou .env.local pour l'utiliser en local.

# URL de l'API Backend NestJS
VITE_API_URL=http://localhost:3010/api

# Numéro WhatsApp Business de support (format international sans +, sans espaces ni tirets, ex: 221770000000)
# Si cette variable n'est pas définie, le bouton de contact WhatsApp sera masqué automatiquement.
VITE_WHATSAPP_SUPPORT_NUMBER=221770000000
